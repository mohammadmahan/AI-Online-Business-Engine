# ============================================================================
# .env.staging.example — AI-First Online Business Engine, STAGING environment
# Stage B artifact (D-141, Approved). Companion to
# local/infra/compose.staging.yml and docs/deployment/dokploy-plan.md §21.2.
#
# ONLY this .example file is committed. The real file (.env.staging) is
# gitignored and NEVER contains values that enter Git, docs, logs, or AI
# prompts (D-045 / PROJECT_RULES §16). At deployment time the six
# DEPLOY-SECRET values are delivered by the deployment layer's environment
# configuration (or the operator's secret store) — never pasted into this
# template's committed sibling.
#
# The six DEPLOY-SECRET entries are fail-closed in the manifest
# (${VAR:?…}): a deploy without them REFUSES. They are listed here as
# NAMES with <SET-BY-DEPLOYMENT-LAYER> placeholders — zero hardcoded
# secrets, by construction.
# ============================================================================

# --- Application environment (promotion contract, phase-03-3 §19) ------------
# staging | production — selects defaults; never changes business logic.
# Staging pins APP_ENV=staging; production overrides to production.
APP_ENV=staging

# --- Canonical PostgreSQL (D-055) — data plane, internal network -------------
# Service name `canonical-db` is the in-network DNS host (F-2: no published
# ports; operator access via SSH tunnel only, Stage C decision).
CANONICAL_DB_HOST=canonical-db
CANONICAL_DB_PORT=5432
CANONICAL_DB_NAME=business_engine_staging
CANONICAL_DB_USER=engine_staging
# DEPLOY-SECRET (fail-closed in manifest):
CANONICAL_DB_PASSWORD=<SET-BY-DEPLOYMENT-LAYER>

# --- WordPress / WooCommerce (projection target — never canonical) -----------
# In-network host is the service name `woodb` (MySQL); WordPress is the only
# frontend-network service. Public URL is assigned at Stage C (staging
# domain, owner-gated); placeholder until then.
WORDPRESS_URL=http://staging-wordpress-placeholder.invalid
WOOCOMMERCE_URL=http://staging-wordpress-placeholder.invalid
WORDPRESS_DB_HOST=woodb:3306
WORDPRESS_DB_USER=wp_staging
WORDPRESS_DB_NAME=wordpress_staging
# DEPLOY-SECRET (fail-closed in manifest):
WORDPRESS_DB_PASSWORD=<SET-BY-DEPLOYMENT-LAYER>
# Credential REFERENCES only — values live in the staging secret store:
WOO_CREDENTIAL_REF=unset-staging-woo-credentials
WOO_REST_NAMESPACE=wc/v3

# --- MySQL root (woodb) -------------------------------------------------------
# DEPLOY-SECRET (fail-closed in manifest):
MYSQL_PASSWORD=<SET-BY-DEPLOYMENT-LAYER>
MYSQL_ROOT_PASSWORD=<SET-BY-DEPLOYMENT-LAYER>

# --- n8n (orchestration only — D-042; internal network, tunnel access) -------
N8N_URL=http://engine-staging-n8n:5678
# DEPLOY-SECRET (fail-closed in manifest):
N8N_ENCRYPTION_KEY=<SET-BY-DEPLOYMENT-LAYER>
N8N_CREDENTIAL_REF=unset-staging-n8n-credentials

# --- Media (D-056 S3-compatible; internal network) ----------------------------
# In-network endpoint is the service container; the production provider
# (Phase 4) remains a drop-in behind services/media_store.py.
MEDIA_ENDPOINT=http://engine-staging-minio:9000
MEDIA_BUCKET=engine-staging-media
MEDIA_REGION=us-east-1
MINIO_ROOT_USER=staging-media
# DEPLOY-SECRET (fail-closed in manifest):
MINIO_ROOT_PASSWORD=<SET-BY-DEPLOYMENT-LAYER>
MEDIA_CREDENTIAL_REF=unset-staging-media-credentials

# --- AI runtime (Phase 7 — STAGING GRANTS NO AI CREDENTIALS, G-B4) ------------
# Intentionally ABSENT from staging: no AI_CREDENTIAL_REF, no AI_* keys.
# AI is enabled=false in staging; any future grant is an explicit,
# separately authorized owner decision (D-045).

# --- Logging (§17) -------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Mock WooCommerce (D-052 layer 2 — never a real instance) -----------------
# Profile-deferred service; variables apply only if that profile is ever
# activated (staging default: inactive).
MOCK_WOO_STATE_PATH=/state/state.json
MOCK_WOO_FAILURE_SCENARIO=
MOCK_WOO_LATENCY_S=0
