# Stage C — Redis cache & broker parameters (D-141).
# Declared today, provisioned only when a component requires it (see
# local/infra/dokploy/README.md stage C/D note). Secure-by-default
# contract pinned here so any future enablement inherits it.

# --- secrets (fail-closed) --------------------------------------------------
REDIS_PASSWORD=
# Redis 6+ ACL: the application role gets a dedicated username; the
# default user is disabled by the requirepass+aclfile contract below.
REDIS_USERNAME=engine_app

# --- durability & eviction (durable queues => noeviction) --------------------
REDIS_MAXMEMORY_POLICY=noeviction
REDIS_MAXMEMORY=256mb
REDIS_APPENDONLY=yes
REDIS_APPENDFSYNC=everysec

# --- transport ----------------------------------------------------------------
REDIS_TLS_ENABLED=yes
