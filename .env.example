# ============================================================================
# .env.example — AI-First Online Business Engine, LOCAL environment
#
# ONLY this file is committed. Copy to .env.local for real use:
#     cp .env.example .env.local
# .env.local / .env.staging / .env.production are gitignored and must
# NEVER contain values that enter Git, docs, Excel, AI prompts, or logs
# (D-045 / PROJECT_RULES §16). Values below are dummy local defaults.
# ============================================================================

# --- Application environment -------------------------------------------------
# local | staging | production — selects defaults; never changes business
# logic (phase-03-3 §19 promotion contract).
APP_ENV=local

# --- Production container runtime (Dokploy work package, D-141) ---------------
# local/infra/compose.prod.yml is the PRODUCTION runtime manifest (hardened:
# no-new-privileges, read-only rootfs + tmpfs seams, non-root users, resource
# limits, ZERO published ports). Its startup pre-flight
# (canonical/runtime_preflight.py) FAILS CLOSED unless all mandatory keys
# below are present and well-formed (values in the deployment env, never
# committed) and prohibited keys (WORDPRESS_DEBUG, AI_LIVE_ENABLED,
# N8N_DIAGNOSTICS_ENABLED) are absent/falsy.
# Validator: python3 local/scripts/validate_dokploy_runtime.py [--gate|--runtime]
#
# PRODUCTION-INJECTED SECRET KEYS (compose.prod.yml `${VAR:?}` contract):
# these keys carry NO value in any committed file. At deploy time the owner
# injects real values via the deployment secret store only (D-045). Listed
# here (empty) so `validate_vps_target.py` O-01 can prove the contract is
# documented without any secret material entering Git (D-124).
WORDPRESS_DB_PASSWORD=
MYSQL_PASSWORD=
MYSQL_ROOT_PASSWORD=
N8N_ENCRYPTION_KEY=
MINIO_ROOT_USER=
MINIO_ROOT_PASSWORD=

# --- Canonical PostgreSQL (D-055) --------------------------------------------
# Local throwaway credentials; staging/production use their own secret store.
CANONICAL_DB_HOST=127.0.0.1
CANONICAL_DB_PORT=55432
CANONICAL_DB_NAME=business_engine_local
CANONICAL_DB_USER=engine_local
CANONICAL_DB_PASSWORD=engine-local-only

# --- WordPress / WooCommerce (projection target — never canonical) -----------
WORDPRESS_URL=http://127.0.0.1:18080
WOOCOMMERCE_URL=http://127.0.0.1:18080
# REST namespace + key/secret are configured at implementation time
# (D-043 verification point). Credential REFERENCES only — values live in
# the environment's secret store, never here:
WOO_CREDENTIAL_REF=unset-local-woo-credentials
WOO_REST_NAMESPACE=wc/v3

# --- n8n (orchestration only — D-042) ----------------------------------------
N8N_URL=http://127.0.0.1:15678
N8N_CREDENTIAL_REF=unset-local-n8n-credentials

# --- Notion (Phase 6 — D-060 lifecycle; live client D-045-gated) --------------
# Live outbound client: deterministic local mock unless
# NOTION_LIVE_ENABLED=true AND NOTION_API_KEY exist (fail-closed; no
# credentials ever committed). Live probe is a read-only /users/me ping.
NOTION_LIVE_ENABLED=false
NOTION_API_KEY=

# --- WooCommerce / WordPress (Phase 3/4 — D-043/D-047 live client) ------------
# Live REST client: deterministic mock unless WOO_LIVE_ENABLED=true AND an
# https store URL AND consumer key/secret exist (fail-closed; D-045).
# RED-tier operations (publish, visible catalog, price-on-published) refuse
# without explicit per-call human authorization (D-050).
WOO_LIVE_ENABLED=false
WOO_STORE_URL=
WOO_CONSUMER_KEY=
WOO_CONSUMER_SECRET=

# --- Instagram (Phase 9 — D-071 gated Graph API adapter) -----------------------
# Deterministic mock unless INSTAGRAM_LIVE_ENABLED=true AND both keys exist.
# Live probe (read-only business fields) behind the same gate.
INSTAGRAM_LIVE_ENABLED=false
INSTAGRAM_ACCESS_TOKEN=
INSTAGRAM_BUSINESS_ID=

# --- Telegram (Phases 9–10 — D-075 gated adapter; ingress contracts) ----------
# Live adapter: deterministic mock unless TELEGRAM_LIVE_ENABLED=true AND a
# bot token exist (fail-closed; D-045 — no credentials ever committed).
TELEGRAM_LIVE_ENABLED=false
TELEGRAM_BOT_TOKEN=
# Ingress: webhook shared secret (x-telegram-bot-api-secret-token), unset =>
# verification refuses (fail-closed). 1–256 of [A-Za-z0-9_-].
TELEGRAM_WEBHOOK_SECRET=

# --- Media (D-056 local emulator; production provider = Phase 4) -------------
MEDIA_ENDPOINT=http://127.0.0.1:19000
MEDIA_BUCKET=engine-local-media
MEDIA_CREDENTIAL_REF=unset-local-media-credentials
MEDIA_REGION=us-east-1

# --- AI runtime (Phases 7–8 — D-062/D-066 live providers; register row 9) -----
# RED-TIER (D-050/D-066): live AI spends real money. Deterministic mock
# unless AI_LIVE_ENABLED=true AND the provider's key exist (fail-closed;
# D-045 — no credential ever committed). Transports are injected; the
# battery never touches a network.
AI_LIVE_ENABLED=false
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
# DeepSeek (OpenAI-schema-compatible; official docs reviewed 2026-09-21)
DEEPSEEK_API_KEY=
# Ollama (LOCAL loopback daemon; the MODEL name is the enablement gate —
# no key exists, none requested; remote hosts need an explicit owner override)
OLLAMA_MODEL=
OLLAMA_BASE_URL=http://127.0.0.1:11434

# --- Phase 11 orchestration drill (D-077/D-078, D-045 fail-closed) ----------
# Opt-in READ-ONLY reachability probe for local services (no writes, no
# publishes, no secrets). Unset or non-"true" → probe refuses (exit 2).
ORCH_LIVE_ENABLED=

# --- Logging (§17) ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Mock WooCommerce (D-052 layer 2 — never a real instance) -----------------
MOCK_WOO_STATE_PATH=local/volumes/mock-woo/state.json
MOCK_WOO_FAILURE_SCENARIO=
MOCK_WOO_LATENCY_S=0
