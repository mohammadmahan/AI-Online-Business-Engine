# ============================================================================
# .env.staging.template — Stage C environment template (G1–G6 dry-run)
#
# Companion to .env.staging.example (the Stage B promotion contract, D-141)
# and local/infra/compose.staging.yml. Where the .example documents the
# contract, this template is the FILL-IN artifact the Stage C dry-run
# harness (local/scripts/stage_c_dry_run.py) validates before any
# provisioning step runs.
#
# D-045: ONLY this .template file is committed; it contains STRICT
# placeholders and zero credential values. The real .env.staging is
# gitignored and its values never enter Git, docs, logs, or AI prompts.
#
# PLACEHOLDER CONVENTIONS
#   <GENERATE_SECURE_PASSWORD>   operator generates at deploy time in the
#                                secret store — never committed, never echoed
#   <SET-AFTER-GRANT:SC-n>       value derives from Stage C owner grant SC-n
#
# STAGE C GRANT MAPPING (read before filling)
#   SC-3  firewall surface      — no variable: the host firewall admits the
#                                 public surface (18080 or the approved proxy
#                                 surface per the signed grant row)
#   SC-4  GitHub connect        — no variable: the deployment layer's
#                                 read-scoped GitHub connection is configured
#                                 in the deployment layer after the grant
#   SC-5  staging DNS           — WORDPRESS_URL / WOOCOMMERCE_URL stay on the
#                                 non-routable .invalid placeholder until the
#                                 granted staging hostname exists
#   SC-7  RPO/RTO + backup      — the commented BACKUP_* block near the end;
#                                 consumed by the Stage C P5 backup
#                                 integration, NOT by compose
# ============================================================================

# --- Application environment (promotion contract, phase-03-3 §19) ------------
APP_ENV=staging

# --- Canonical PostgreSQL (service: canonical-db — internal `data` network) --
CANONICAL_DB_HOST=canonical-db
CANONICAL_DB_PORT=5432
CANONICAL_DB_NAME=business_engine_staging
CANONICAL_DB_USER=engine_staging
# DEPLOY-SECRET (fail-closed in manifest ${VAR:?}):
CANONICAL_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>

# --- WordPress / WooCommerce (service: wordpress — SOLE `frontend` surface) --
# SC-5: replace the .invalid placeholders with the granted staging hostname
# (TLS is attached by the deployment layer's proxy, never encoded here).
WORDPRESS_URL=http://staging-wordpress-placeholder.invalid
WOOCOMMERCE_URL=http://staging-wordpress-placeholder.invalid
WORDPRESS_DB_HOST=woodb:3306
WORDPRESS_DB_USER=wp_staging
WORDPRESS_DB_NAME=wordpress_staging
# DEPLOY-SECRET (fail-closed in manifest ${VAR:?}):
WORDPRESS_DB_PASSWORD=<GENERATE_SECURE_PASSWORD>
# Credential REFERENCES only — values live in the staging secret store:
WOO_CREDENTIAL_REF=unset-staging-woo-credentials
WOO_REST_NAMESPACE=wc/v3

# --- MySQL root (service: woodb — internal `data` network) -------------------
# DEPLOY-SECRETs (fail-closed in manifest ${VAR:?}):
MYSQL_PASSWORD=<GENERATE_SECURE_PASSWORD>
MYSQL_ROOT_PASSWORD=<GENERATE_SECURE_PASSWORD>

# --- n8n (service: n8n — internal `data` network; SC-8: TUNNEL access) -------
N8N_URL=http://engine-staging-n8n:5678
# DEPLOY-SECRET (fail-closed in manifest ${VAR:?}):
N8N_ENCRYPTION_KEY=<GENERATE_SECURE_PASSWORD>
N8N_CREDENTIAL_REF=unset-staging-n8n-credentials

# --- Media / MinIO (service: media — internal `data` network) ----------------
MEDIA_ENDPOINT=http://engine-staging-minio:9000
MEDIA_BUCKET=engine-staging-media
MEDIA_REGION=us-east-1
MINIO_ROOT_USER=staging-media
# DEPLOY-SECRET (fail-closed in manifest ${VAR:?}):
MINIO_ROOT_PASSWORD=<GENERATE_SECURE_PASSWORD>
MEDIA_CREDENTIAL_REF=unset-staging-media-credentials

# --- AI runtime (Phase 7 — STAGING GRANTS NO AI CREDENTIALS, G-B4) -----------
# Intentionally ABSENT: no AI_* keys may appear in this file, ever. Any
# future grant is an explicit, separately authorized owner decision (D-045).

# --- Logging (§17) ------------------------------------------------------------
LOG_LEVEL=info
LOG_FORMAT=json

# --- Mock WooCommerce (D-052 layer 2 — profile-deferred, inactive) -----------
MOCK_WOO_STATE_PATH=/state/state.json
MOCK_WOO_FAILURE_SCENARIO=
MOCK_WOO_LATENCY_S=0

# --- SC-7 backup destination (COMMENTED — not consumed by compose) -----------
# Filled at Stage C P5 from the signed SC-7 grant: off-host S3-compatible,
# encrypted bucket with isolated minimum-permission credentials (write + list
# on one bucket prefix only). Key NAMES only here — never values (D-045).
# BACKUP_S3_ENDPOINT=<SET-AFTER-GRANT:SC-7>
# BACKUP_S3_BUCKET=<SET-AFTER-GRANT:SC-7>
# BACKUP_S3_PREFIX=<SET-AFTER-GRANT:SC-7>
# BACKUP_CREDENTIAL_REF=unset-staging-backup-credentials
