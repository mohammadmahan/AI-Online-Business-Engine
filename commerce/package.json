{
  "name": "commerce",
  "version": "0.1.0",
  "private": true,
  "description": "E-Commerce & Social Publishing track (D-172) — fashion catalog data core (Drizzle schema/contracts) plus the merchant admin surface (Phase 2)",
  "scripts": {
    "dev": "next dev",
    "build": "next build",
    "start": "next start",
    "lint": "eslint .",
    "typecheck": "tsc --noEmit",
    "test": "npm run test:build && node --import ./test/register.mjs --test .test-build",
    "test:build": "tsc -p tsconfig.test.json",
    "db:generate": "drizzle-kit generate",
    "db:check": "drizzle-kit check",
    "db:migrate": "drizzle-kit migrate",
    "db:studio": "drizzle-kit studio",
    "db:up": "docker compose -f docker-compose.db.yml up -d --wait",
    "db:down": "docker compose -f docker-compose.db.yml down",
    "db:reset": "node scripts/db-reset.mjs && npm run db:migrate",
    "db:seed": "node scripts/seed-catalog.mjs",
    "smoke:db": "npm run test:build && node --import ./test/register.mjs --test --test-concurrency=1 .test-build/__tests__/live-db",
    "verify": "npm run typecheck && npm run lint && npm run test && npm run db:check"
  },
  "dependencies": {
    "@radix-ui/react-dialog": "1.1.23",
    "@radix-ui/react-slot": "1.3.3",
    "drizzle-orm": "0.45.4",
    "lucide-react": "0.545.0",
    "next": "16.3.8",
    "pg": "8.23.1",
    "react": "19.3.0",
    "react-dom": "19.3.0"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "4.3.3",
    "@types/node": "20.19.43",
    "@types/pg": "8.23.1",
    "@types/react": "19.3.0",
    "@types/react-dom": "19.3.0",
    "drizzle-kit": "0.31.11",
    "eslint": "9.39.5",
    "eslint-config-next": "16.3.8",
    "tailwindcss": "4.3.3",
    "typescript": "5.9.3"
  }
}
