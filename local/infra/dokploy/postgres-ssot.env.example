# Stage B — PostgreSQL SSOT provisioning parameters (D-141).
# fail-closed references ONLY: no credential values in Git (D-045).
# The deployment layer injects real values from the per-environment
# secret store; missing values abort provisioning.

# --- SSOT identity (non-secret) -------------------------------------------
# Names mirror compose.prod.yml's fail-closed ${VAR:?} references so the
# deployment layer can map this file 1:1 onto the manifest environment.
CANONICAL_DB_NAME=business_engine_prod
CANONICAL_DB_USER=engine_prod

# --- secrets (fail-closed) --------------------------------------------------
CANONICAL_DB_PASSWORD=
# Superuser/replication credentials are intentionally NOT declared here:
# the SSOT container runs with a single application role; replication is
# a Stage B+ owner decision with its own secret store entries.

# --- WAL archiving parameters (Stage B scope) --------------------------------
# Archive destination is an owner-provisioned volume/outside-store mount
# (the D-125 verified-freeze archive layer consumes it); parameters are
# declared so provisioning review sees the contract before activation.
# Passed to the container as POSTGRES_* init parameters (docker-library
# postgres contract): the archive command itself is mounted by the
# deployment layer — no inline shell with credentials.
PG_ARCHIVE_MODE=on
PG_ARCHIVE_TIMEOUT=300s
PG_WAL_KEEP_SIZE=1GB
